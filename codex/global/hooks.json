{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{CODEX_HOME}}/hooks/global_user_prompt_submit.sh\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{{CODEX_HOME}}\\hooks\\global_user_prompt_submit.ps1\"",
            "statusMessage": "전역 요청 컨텍스트 확인 중"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{CODEX_HOME}}/hooks/global_session_start.sh\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{{CODEX_HOME}}\\hooks\\global_session_start.ps1\"",
            "statusMessage": "전역 세션 컨텍스트 확인 중"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{CODEX_HOME}}/hooks/global_post_tool_use.sh\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{{CODEX_HOME}}\\hooks\\global_post_tool_use.ps1\"",
            "statusMessage": "전역 도구 사용 기록 확인 중"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"{{CODEX_HOME}}/hooks/global_stop_check.sh\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{{CODEX_HOME}}\\hooks\\global_stop_check.ps1\"",
            "timeout": 30,
            "statusMessage": "전역 완료 조건 확인 중"
          }
        ]
      }
    ]
  }
}