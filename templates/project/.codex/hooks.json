{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/user_prompt_submit.ps1",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/user_prompt_submit.ps1",
            "statusMessage": "요청 유형 분석 중"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/session_start.ps1",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/session_start.ps1",
            "statusMessage": "작업 기억 로드 중"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/post_tool_use.ps1",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/post_tool_use.ps1",
            "statusMessage": "수정 기록 중"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/stop_guard.ps1",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File .codex/hooks/stop_guard.ps1",
            "timeout": 30,
            "statusMessage": "완료 조건 확인 중"
          }
        ]
      }
    ]
  }
}
